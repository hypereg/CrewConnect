{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/notifications",
      "destination": "/api/workspace?resource=notifications"
    },
    {
      "source": "/api/games",
      "destination": "/api/workspace?resource=games"
    }
  ],
  "functions": {
    "api/duties.mjs": {
      "includeFiles": "riva-asr.proto"
    },
    "api/duties/completion.mjs": {
      "includeFiles": "riva-asr.proto"
    },
    "api/reports.mjs": {
      "includeFiles": "riva-asr.proto"
    },
    "api/reports/draft.mjs": {
      "includeFiles": "riva-asr.proto"
    }
  }
}
